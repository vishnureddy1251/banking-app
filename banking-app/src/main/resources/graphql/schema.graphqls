type Query {
    allAccounts: [Account!]!
    accountById(id: ID!): Account
    allCustomers: [Customer!]!
    customerById(id: ID!): Customer
    searchCustomers(name: String!): [Customer!]!
    transactionsByAccount(accountId: ID!): [Transaction!]!
    transactionsByType(accountId: ID!, type: String!): [Transaction!]!
    allLoans: [Loan!]!
    loanById(id: ID!): Loan
    loansByAccount(accountId: ID!): [Loan!]!
    loansByStatus(status: String!): [Loan!]!
    notificationsByAccount(accountId: ID!): [Notification!]!
    unreadNotifications(accountId: ID!): [Notification!]!
    unreadCount(accountId: ID!): Int!
    billsByAccount(accountId: ID!): [BillPayment!]!
}

type Mutation {
    createAccount(input: CreateAccountInput!): Account!
    deposit(accountId: ID!, amount: Float!): Account!
    withdraw(accountId: ID!, amount: Float!): Account!
    transfer(input: TransferInput!): TransferResult!
    deleteAccount(id: ID!): String!
    createCustomer(input: CreateCustomerInput!): Customer!
    applyLoan(input: ApplyLoanInput!): Loan!
    approveLoan(id: ID!): Loan!
    rejectLoan(id: ID!): Loan!
    repayLoan(id: ID!, amount: Float!): Loan!
    payBill(input: PayBillInput!): BillPayment!
    markAsRead(id: ID!): Notification!
    markAllAsRead(accountId: ID!): String!
}

type Account {
    id: ID!
    accountName: String!
    accountNumber: String
    accountType: String!
    balance: Float!
    createdAt: String
    updatedAt: String
    transactions: [Transaction!]
    loans: [Loan!]
}

type Customer {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    phone: String
    address: String
    city: String
    state: String
    zipCode: String
}

type Transaction {
    id: ID!
    accountId: Long!
    transactionType: String!
    amount: Float!
    balanceAfter: Float!
    relatedAccountId: Long
    description: String
    transactionDate: String
}

type Loan {
    id: ID!
    accountId: Long!
    loanType: String!
    loanAmount: Float!
    amountPaid: Float
    remainingBalance: Float
    interestRate: Float!
    tenureMonths: Int!
    status: String!
    createdAt: String
}

type BillPayment {
    id: ID!
    accountId: Long!
    billType: String!
    providerName: String
    consumerNumber: String
    amount: Float!
    referenceNumber: String
    status: String!
    paidAt: String
}

type Notification {
    id: ID!
    accountId: Long!
    title: String!
    message: String!
    channel: String
    category: String
    isRead: Boolean!
    createdAt: String
}

type TransferResult {
    message: String!
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
}